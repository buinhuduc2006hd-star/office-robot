<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="virtual_lab">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Sim World Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <magnetic_field>
      6e-06 2.3e-05 -4.2e-05
    </magnetic_field>


    <!-- Sun -->
    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>
        0 0 10
        0 0 0
      </pose>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>
        -0.5 0.1 -0.9
      </direction>

    </light>


    <!-- Ground Plane -->
    <model name="ground_plane">

      <static>true</static>

      <pose>
        0 0 -0.05
        0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>

          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>

        </visual>

      </link>

    </model>


    <!-- CPR Office -->
    <include>

      <uri>
        file:///home/duc/office_robot_ws/src/mo_hinh/models/cpr_office
      </uri>

      <name>
        cpr_office
      </name>

      <pose>
        0 0 0
        0 0 0
      </pose>

    </include>

    <!-- Walking Actor -->
    <include>
      <uri>file:///home/duc/office_robot_ws/src/mo_hinh/worlds/Walking_actor</uri>
      <name>walking_actor</name>
      <pose>-0.5 2.0 1.0 0 0 0</pose>
    </include>

  </world>

</sdf>
